{
  "manifest_version": 3,
  "name": "YouTube Manager",
  "version": "0.3.0",
  "description": "Bookmark start/end points in YouTube videos, synced to your own GitHub Gist.",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["js/youtube.js", "js/storage.js", "js/bookmarks.js", "js/row.js", "js/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"],
  "host_permissions": ["https://api.github.com/*", "*://*.youtube.com/*"]
}
